{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meierfutsal",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meier-futsal-db",
      "database_id": "9532ce8f-0dda-4103-a694-44262a1a2ff2",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "meier-futsal-imagens"
    }
  ]
}
